# Local-only environment. Copy to .env (gitignored) and edit.
# Never put production secrets here.

APP_PORT=4000
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
REDIS_PORT=6379

# Application services (uncomment when wired)
# DATABASE_URL=postgres://app:app@localhost:5432/app
# REDIS_URL=redis://localhost:6379
# APP_BASE_URL=http://localhost:4000
# LOG_LEVEL=debug
