# Public base URL of this app, no trailing slash.
BASE_URL=http://localhost:5556
PORT=5556

# From the TrustNet RP portal (https://me.trustnet.app/rp/new). Shown once.
TRUSTNET_CLIENT_ID=
TRUSTNET_CLIENT_SECRET=
TRUSTNET_ISSUER=https://id.trustnet.app
TRUSTNET_WEBHOOK_JWKS=https://rp.trustnet.app/api/v1/webhook/jwks

# Where the SQLite file lives.
DATABASE_PATH=./data.sqlite

# Local testing only: enables /dev/login?as=alice so you can try the app
# with several fake users before registering with TrustNet.
# Ignored when NODE_ENV=production.
DEV_FAKE_LOGIN=0
